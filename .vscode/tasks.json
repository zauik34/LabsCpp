{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build lab1",
            "type": "shell",
            "command": "build.cmd",
            "args": ["main"],
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "cmd.exe",
                    "args": ["/d", "/c"]
                }
            },
            "problemMatcher": "$msCompile",
            "group": {"kind": "build", "isDefault": true}
        },
        {
            "label": "Build tests",
            "type": "shell",
            "command": "build.cmd",
            "args": ["tests"],
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "cmd.exe",
                    "args": ["/d", "/c"]
                }
            },
            "problemMatcher": "$msCompile",
            "group": "build"
        }
    ]
}
